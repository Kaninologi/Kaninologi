<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Kaninhold | Kaninologi</title>

  <meta name="description"
        content="Praktisk viden om kaninhold, indretning, bolig og hverdagen med kaniner.">

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #ffffff;
      color: #222222;
      font-family: Arial, Helvetica, sans-serif;
    }

    .top {
      text-align: center;
      padding: 28px 20px 24px;
    }

    .logo {
      margin: 0;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 3px;
    }

    .logo a {
      color: #222222;
      text-decoration: none;
    }

    .menu-bar {
      background: #536557;
    }

    .menu {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
    }

    .menu a {
      min-height: 54px;
      padding: 0 18px;
      display: flex;
      align-items: center;
      color: #ffffff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
    }

    .menu a:hover,
    .menu a.active {
      background: rgba(255,255,255,0.12);
    }

    .mobile-menu-button {
      display: none;
      width: 100%;
      height: 52px;
      border: 0;
      background: #536557;
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    .page-header {
      max-width: 850px;
      margin: 0 auto;
      padding: 80px 25px 55px;
      text-align: center;
    }

    .page-header h1 {
      margin: 0 0 20px;
      font-size: clamp(48px, 8vw, 76px);
      line-height: 1;
      letter-spacing: -2px;
    }

    .page-header p {
      max-width: 650px;
      margin: 0 auto;
      color: #555555;
      font-size: 19px;
      line-height: 1.6;
    }

    .articles {
      max-width: 950px;
      margin: 0 auto;
      padding: 0 25px 100px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .article-card {
      min-height: 190px;
      padding: 30px;
      background: #f4f6f3;
      border: 1px solid #e5e9e3;
      color: #222222;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .article-card h2 {
      margin: 0 0 8px;
      font-size: 24px;
    }

    .article-card p {
      margin: 0;
      color: #666666;
      line-height: 1.5;
    }

    footer {
      border-top: 1px solid #eeeeee;
      padding: 30px;
      text-align: center;
      color: #777777;
      font-size: 13px;
    }

    @media (max-width: 850px) {

      .mobile-menu-button {
        display: block;
      }

      .menu {
        display: none;
        flex-direction: column;
      }

      .menu.mobile-open {
        display: flex;
      }

      .menu a {
        min-height: 48px;
        padding: 0 22px;
        border-top: 1px solid rgba(255,255,255,0.10);
      }

      .articles {
        grid-template-columns: 1fr;
      }

      .page-header {
        padding-top: 55px;
      }

    }

  </style>
</head>

<body>

<header>

  <div class="top">
    <p class="logo">
      <a href="index.html">KANINOLOGI</a>
    </p>
  </div>

  <div class="menu-bar">

    <button class="mobile-menu-button" id="mobileMenu">
      Menu ☰
    </button>

    <nav class="menu" id="mainMenu">

      <a href="index.html">Forside</a>

      <a href="sundhed.html">Sundhed</a>

      <a href="ernaering.html">Ernæring</a>

      <a href="adfaerd.html">Adfærd</a>

      <a href="planter.html">Planter</a>

      <a href="kaninhold.html" class="active">Kaninhold</a>

      <a href="om.html">Om Kaninologi</a>

    </nav>

  </div>

</header>

<main>

  <section class="page-header">

    <h1>Kaninhold</h1>

    <p>
      Viden om kaninens rammer, indretning og hverdagen med kaniner.
    </p>

  </section>

  <section class="articles">

    <div class="article-card">

      <h2>Den gode base</h2>

      <p>
        Indretning, plads og gode rammer for kaninens hverdag.
      </p>

    </div>

    <div class="article-card">

      <h2>Vinterflytning</h2>

      <p>
        Hvad skal du være opmærksom på, hvis en udekanin skal flytte ind?
      </p>

    </div>

  </section>

</main>

<footer>
  © 2026 Kaninologi · Viden om kaniner
</footer>

<script>

  const mobileMenu = document.getElementById("mobileMenu");
  const mainMenu = document.getElementById("mainMenu");

  mobileMenu.addEventListener("click", function() {
    mainMenu.classList.toggle("mobile-open");
  });

</script>

</body>
</html>
